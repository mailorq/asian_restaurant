# Copy to `.env` and adjust. `.env` is gitignored.

DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173
DJANGO_LOG_LEVEL=INFO

# 1 in production (https-only cookies), 0 for plain-http local runs
DJANGO_COOKIE_SECURE=0
DJANGO_SSL_REDIRECT=0

POSTGRES_DB=asian_restaurant
POSTGRES_USER=asian
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgres://asian:change-me-postgres@db:5432/asian_restaurant

REDIS_URL=redis://redis:6379/1
# server-side cart store (kept on a separate db from the cache/rate-limit)
CART_REDIS_URL=redis://redis:6379/0
# set to true only behind a reverse proxy that sanitizes X-Forwarded-For
RATELIMIT_TRUST_XFF=false

# delivery address verification (server-side geocoder)
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=AsianRestaurant/1.0 (+delivery verification)
GEOCODER_TIMEOUT=5

# rabbitmq (reliable order delivery)
RABBITMQ_USER=asian
RABBITMQ_PASSWORD=change-me-rabbit
RABBITMQ_URL=amqp://asian:change-me-rabbit@rabbitmq:5672/

# vite dev server proxies /api and /admin to this upstream
VITE_API_PROXY=http://backend:8000
