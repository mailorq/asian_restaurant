# Tracked, non-secret config for the isolated E2E stack (scripts/e2e_reconcile.sh).
# Test-only credentials — never reused for real environments.
DJANGO_SECRET_KEY=e2e-insecure-secret-key-for-tests-only-0000000000
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_LOG_LEVEL=WARNING
DJANGO_COOKIE_SECURE=0
DJANGO_SSL_REDIRECT=0

POSTGRES_DB=asian_restaurant
POSTGRES_USER=asian
POSTGRES_PASSWORD=e2e-pg
DATABASE_URL=postgres://asian:e2e-pg@db:5432/asian_restaurant

REDIS_URL=redis://redis:6379/1
CART_REDIS_URL=redis://redis:6379/0
RATELIMIT_TRUST_XFF=false

GEOCODER_ENABLED=false
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=AsianRestaurant/e2e
GEOCODER_TIMEOUT=5

# must match ops/rabbitmq/definitions.dev.json (loaded by the dev broker)
RABBITMQ_USER=asian
RABBITMQ_PASSWORD=change-me-rabbit
RABBITMQ_URL=amqp://storefront_app:change-me-rabbit@rabbitmq:5672/storefront
RABBITMQ_ADMIN_USER=asian
RABBITMQ_ADMIN_PASSWORD=change-me-rabbit

OPERATIONS_DB_NAME=operations
OPERATIONS_DB_USER=ops_user
OPERATIONS_DB_PASSWORD=e2e-ops
OPERATIONS_SECRET_KEY=e2e-ops-secret
OPERATIONS_RABBITMQ_URL=amqp://operations_consumer:change-me-ops-mq@rabbitmq:5672/operations
OPERATIONS_BRIDGE_CONSUME_URL=amqp://operations_bridge:change-me-bridge-mq@rabbitmq:5672/storefront
OPERATIONS_BRIDGE_PUBLISH_URL=amqp://operations_bridge:change-me-bridge-mq@rabbitmq:5672/operations

VITE_API_PROXY=http://backend:8000
