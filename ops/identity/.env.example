# Identity signing configuration template. Copy the relevant non-secret values to
# your local .env; never copy a PEM value into this file or commit it.

# Local development: run `bash scripts/dev_gen_jwt_key.sh` once.
IDENTITY_JWT_PRIVATE_KEY_FILE=/run/identity/jwt_private_key.pem
IDENTITY_JWT_KID=dev-local-1
IDENTITY_JWT_TTL=600

# Key rotation: the old key's public PEM may be exposed through JWKS only until
# all tokens signed with it have expired. Leave both blank when not rotating.
IDENTITY_JWT_PREVIOUS_PUBLIC_KEY_FILE=
IDENTITY_JWT_PREVIOUS_KID=
